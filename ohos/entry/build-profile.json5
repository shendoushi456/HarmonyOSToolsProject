
{
  "apiType": 'stageMode',
  "buildOption": {
    // 真机开发仅支持 ARM64；避免将模拟器 x86_64 Flutter 引擎打入 HAP。
    "externalNativeOptions": {
      "abiFilters": ["arm64-v8a"]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "ohosTest",
    }
  ]
}
